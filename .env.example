# App
NEXT_PUBLIC_APP_NAME=NewViral Studio

# Modo Free funciona sem nenhuma chave. Integrações abaixo são opcionais.
# Google Veo 3.1
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-generate-preview

# Pollinations (free-first / Pollen)
POLLINATIONS_API_KEY=
POLLINATIONS_VIDEO_MODEL=alibaba/wan-2.2-fast

# Fallback local sem API externa
FREE_VIDEO_FALLBACK=ffmpeg

# Runway Gen-4.5 (alternativa independente)
RUNWAYML_API_SECRET=
RUNWAY_MODEL=gen4.5

# Kling 2.6 via fal.ai
FAL_KEY=

# OpenAI (imagem; Sora/Videos API foi removido em 24/09/2026)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Supabase - use as chaves novas em projetos criados em 2026
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Compatibilidade com projetos Supabase antigos
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
